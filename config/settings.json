{
  "brand": "AI Daily Brief",
  "tagline": "The AI news worth your time, every day.",
  "language": "en-GB",
  "lookback_hours": 36,
  "lookback_hours_max": 96,
  "min_text_chars": 120,
  "max_per_source_in_issue": 2,
  "deny_title_patterns": ["^quoting\\b", "\\bpodcast\\b", "\\bsponsor", "\\bweekly (roundup|digest)\\b", "^import ai \\d+",
    "\\bdays? left\\b", "\\bfounder summit\\b", "\\bearly[- ]bird\\b", "\\b(register now|tickets?)\\b", "\\bwebinar\\b",
    "^[\\w.\\-]+ v?\\d+\\.\\d+(\\.\\d+)?([ab]|rc)?\\d*$", "^[\\w.\\-]+/[\\w.\\-]+$"],
  "max_per_source": 15,
  "candidates_to_write": 9,
  "items_in_issue": 6,
  "min_items": 3,
  "history_days": 28,
  "pack": {"active_slots": ["morning", "evening"]},
  "paused": false,
  "llm": {
    "provider": "groq",
    "fallback_provider": "gemini",
    "checker_provider": "gemini",
    "checker_fallback_provider": "groq",
    "time_budget_seconds": 150,
    "gemini_model": "gemini-3.6-flash",
    "gemini_fallback_models": ["gemini-3.5-flash", "gemini-3.7-flash", "gemini-3.8-flash"],
    "groq_model": "openai/gpt-oss-120b",
    "groq_fallback_models": ["qwen/qwen3.8-27b", "openai/gpt-oss-20b"],
    "max_llm_calls_per_day": 10,
    "second_pass_check": true,
    "fall_back_to_extractive": true
  },
  "review_agent": {"enabled": true, "recommend_at": 90, "review_at": 70},
  "facts_only": {
    "enabled": true,
    "allowed_kinds": ["announced", "reported"],
    "require_quote": true,
    "hedge_patterns": [
      "\\breportedly\\b", "\\brumou?rs?\\b", "\\bleak(ed|s)?\\b", "\\ballegedly\\b", "\\bunconfirmed\\b",
      "\\baccording to (sources|people)\\b", "\\bpeople familiar\\b", "\\bspeculat\\w*", "\\bin talks\\b",
      "(?-i:\\bmay\\b)", "\\bmight\\b", "\\bcould\\b", "\\bexpected to\\b", "\\bsaid to\\b", "\\blikely to\\b",
      "\\bpredict\\w*", "\\bwhat if\\b"
    ],
    "opinion_title_patterns": ["^i (built|tried|made|used|let|asked)\\b", "\\bmy take\\b", "\\bwhy i\\b", "\\bop-ed\\b",
      "\\bopinion\\b", "\\bhot take\\b", "\\bwe have .* at home\\b"]
  },
  "verify": {
    "check_links": true,
    "max_unsupported_names": 1
  },
  "linkedin": {
    "hashtags": ["#AI", "#ArtificialIntelligence", "#AINews"],
    "max_chars": 2800
  },
  "site": {
    "base_url": "https://kunjchacha.github.io/ai-daily-brief",
    "contact": "https://www.linkedin.com/in/kunjchacha"
  }
}
